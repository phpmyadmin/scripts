# Copy to .env and fill in. .env is git-ignored.
# Key names are the ones the Sentry stack used. Against an existing .env only
# SENTRY_SECRET_KEY has to change (>= 64 bytes), the two data paths, and
# the two SMTP keys below.

# openssl rand -hex 32
SENTRY_SECRET_KEY=""
# Unchanged from the Sentry stack if set. Keep it hex: it is embedded in
# DATABASE_URL, where "@", ":" or "/" would need percent-encoding.
POSTGRES_PASSWORD=""

# Must not point at the Sentry data: that cluster is PostgreSQL 13.
POSTGRES_DATA_VOLUME="../../../error-tracking-pg-data"
SENTRY_DATA_VOLUME="../../../error-tracking-data"

# Required. The address SDKs reach, https, without a trailing slash. It goes
# into every DSN, so a wrong value shows up as unreachable ingest.
PUBLIC_URL="https://error-tracking.example.com"

# Required. The name the relay sends in its SMTP HELO; use this host's FQDN.
SMTP_HELO_HOSTNAME="error-tracking.example.com"
# Required. Sender of alert and invitation email; a bare localhost sender is
# rejected by most receivers.
SENTRY_SERVER_EMAIL="alerts@example.com"

# Defaults from compose.yml; uncomment to override.
# Marks the session cookie Secure. Lower to false only for plain HTTP.
#COOKIE_SESSION_SECURE="true"
#CREATE_SUPERUSER="admin@example.com:change-me"
#SERVER_PORT="9000"
